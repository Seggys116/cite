CITE_REPO=owner/repo
CITE_GITHUB_TOKEN=
# Node mode (docker-compose.node.yml + docker-compose.orchestrator.yml): the same variable is the connector's default GitHub token for every site it builds.
# Use a fine-grained token with Contents:read, or a classic PAT with repo scope. It is kept in the connector's environment, not in the node's data volume; this file and Docker's container config still hold it, so protect both.
# CITE_GITHUB_TOKEN_FILE is an alternative for secret mounts (the file must be mounted into the connector); the variable wins when both are set.
# Node mode only: Doppler token the connector uses for sites bound to a Doppler project and config without a token of their own (CITE_DOPPLER_TOKEN_FILE works like the GitHub one).
CITE_DOPPLER_TOKEN=
# Seconds between Doppler syncs of every bound site (at least 60); a change redeploys the site.
CITE_DOPPLER_POLL_SECS=300
CITE_BRANCH=main
CITE_POLL_INTERVAL=5m
CITE_VERSION=0.4.1
CITE_NODE=22
CITE_BIND=0.0.0.0
CITE_PORT=8080

# Largest memory and CPU a site stack may request (proxy bounds are 256m / 0.25 minimum)
CITE_STACK_MAX_MEM=16g
CITE_STACK_MAX_CPUS=8

# How site executors reach the internet (per site: outbound and outbound_rules): filtered (default, public internet only
# through a per-stack egress proxy), open (direct bridge, no filtering) or off. CITE_STACK_EXECUTOR_EGRESS=true/false is
# still read when this is empty and maps to filtered/off.
CITE_STACK_EGRESS_MODE=filtered
# Bridge network the connector creates for egress proxies only
CITE_STACK_EGRESS_BRIDGE=cite-egress
# Filtered mode: private ranges every site may reach (for example a LAN database, 192.168.10.0/24), extra public ranges
# and host names (suffix match) no site may reach, and the allowed destination ports (empty: every port; sites block
# the mail ports 25, 465 and 587 unless their outbound_rules turn block_mail off)
CITE_STACK_EGRESS_ALLOW_CIDRS=
CITE_STACK_EGRESS_DENY_CIDRS=
CITE_STACK_EGRESS_DENY_HOSTS=
CITE_STACK_EGRESS_ALLOW_PORTS=
# Filtered mode: this node's own public IPs (comma list of IPs or CIDRs). They are added to every egress proxy's deny
# list so a site cannot reach the node's other services through its public address; set them on any public node.
CITE_NODE_PUBLIC_IPS=

# Self-hosted forge a site may build from (kind: github, gitlab or gitea); both must be set together, https only
CITE_STACK_FORGE=
CITE_STACK_FORGE_API_URL=
