CITE_REPO=owner/repo
CITE_GITHUB_TOKEN=
# Node mode (docker-compose.node.yml + docker-compose.orchestrator.yml): the same variable is the connector's default GitHub token for every site it builds.
# Use a fine-grained token with Contents:read, or a classic PAT with repo scope. It is kept in the connector's environment, not in the node's data volume; this file and Docker's container config still hold it, so protect both.
# CITE_GITHUB_TOKEN_FILE is an alternative for secret mounts (the file must be mounted into the connector); the variable wins when both are set.
# Node mode only: Doppler token the connector uses for sites bound to a Doppler project and config without a token of their own (CITE_DOPPLER_TOKEN_FILE works like the GitHub one).
CITE_DOPPLER_TOKEN=
# Seconds between Doppler syncs of every bound site (at least 60); a change redeploys the site.
CITE_DOPPLER_POLL_SECS=300
CITE_BRANCH=main
CITE_POLL_INTERVAL=5m
CITE_VERSION=0.4.1
CITE_NODE=22
CITE_BIND=0.0.0.0
CITE_PORT=8080

# Largest memory and CPU a site stack may request (proxy bounds are 256m / 0.25 minimum)
CITE_STACK_MAX_MEM=16g
CITE_STACK_MAX_CPUS=8

# Self-hosted forge a site may build from (kind: github, gitlab or gitea); both must be set together, https only
CITE_STACK_FORGE=
CITE_STACK_FORGE_API_URL=
